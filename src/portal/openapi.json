{
  "openapi": "3.1.1",
  "info": {
    "title": "Fleet API",
    "version": "1.0.0"
  },
  "paths": {
    "/api/commands": {
      "get": {
        "tags": [
          "Commands"
        ],
        "summary": "Get the 20 most recent commands",
        "operationId": "GetRecentCommands",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/CommandSummary"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Commands"
        ],
        "summary": "Create a diagnostics command for a device, group, or fleet",
        "operationId": "CreateCommand",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCommandRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CreateCommandResult"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/commands/{id}": {
      "get": {
        "tags": [
          "Commands"
        ],
        "summary": "Get command progress and a page of per-device results",
        "operationId": "GetCommandProgress",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "$ref": "#/components/schemas/CommandTargetStatus"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CommandProgress"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/fleet/summary": {
      "get": {
        "tags": [
          "Fleet"
        ],
        "summary": "Get fleet and regional connection and health counts",
        "operationId": "GetFleetSummary",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FleetSummary"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices": {
      "get": {
        "tags": [
          "Devices"
        ],
        "summary": "Search and filter devices",
        "operationId": "SearchDevices",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "regionId",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "siteId",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "status",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "health",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "page",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          },
          {
            "name": "pageSize",
            "in": "query",
            "schema": {
              "pattern": "^-?(?:0|[1-9]\\d*)$",
              "type": [
                "integer",
                "string"
              ],
              "format": "int32"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DevicePage"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/devices/{id}": {
      "get": {
        "tags": [
          "Devices"
        ],
        "summary": "Get a device and its latest telemetry",
        "operationId": "GetDevice",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeviceDetail"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/rollouts": {
      "get": {
        "tags": [
          "Rollouts"
        ],
        "operationId": "GetRecentRollouts",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/RolloutSummary"
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Rollouts"
        ],
        "summary": "Start a staged rollout for matching devices, ordered by serial number",
        "operationId": "CreateRollout",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateRolloutRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RolloutSummary"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/rollouts/{id}": {
      "get": {
        "tags": [
          "Rollouts"
        ],
        "operationId": "GetRolloutProgress",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RolloutProgress"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo": {
      "get": {
        "tags": [
          "Demo"
        ],
        "operationId": "GetDemoStatus",
        "responses": {
          "200": {
            "description": "OK",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoStatus"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Demo"
        ],
        "operationId": "ApplyDemoControl",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DemoRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "description": "Accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoStatus"
                }
              }
            }
          },
          "400": {
            "description": "Bad Request",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/HttpValidationProblemDetails"
                }
              }
            }
          },
          "409": {
            "description": "Conflict",
            "content": {
              "application/problem\u002Bjson": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CommandId": {
        "type": "string",
        "format": "uuid"
      },
      "CommandKind": {
        "type": "integer"
      },
      "CommandProgress": {
        "required": [
          "summary",
          "total",
          "page",
          "pageSize",
          "items"
        ],
        "type": "object",
        "properties": {
          "summary": {
            "$ref": "#/components/schemas/CommandSummary"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "page": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pageSize": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CommandTargetResult"
            }
          }
        }
      },
      "CommandSummary": {
        "required": [
          "id",
          "kind",
          "createdAtUtc",
          "expiresAtUtc",
          "total",
          "pending",
          "acknowledged",
          "succeeded",
          "failed",
          "expired"
        ],
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "$ref": "#/components/schemas/CommandKind"
          },
          "createdAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "expiresAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "total": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "pending": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "acknowledged": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "succeeded": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "failed": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "expired": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CommandTargetResult": {
        "required": [
          "id",
          "deviceId",
          "serialNumber",
          "model",
          "regionName",
          "status",
          "retryCount",
          "acknowledgedAtUtc",
          "completedAtUtc",
          "detail"
        ],
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/CommandId"
          },
          "deviceId": {
            "$ref": "#/components/schemas/DeviceId"
          },
          "serialNumber": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "regionName": {
            "type": "string"
          },
          "status": {
            "$ref": "#/components/schemas/CommandTargetStatus"
          },
          "retryCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "acknowledgedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "completedAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "detail": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "CommandTargetStatus": {
        "type": "integer"
      },
      "CreateCommandRequest": {
        "required": [
          "kind",
          "deviceId",
          "regionId",
          "model",
          "fleet",
          "expiresInSeconds"
        ],
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/CommandKind"
          },
          "deviceId": {
            "type": [
              "null",
              "string"
            ],
            "format": "uuid"
          },
          "regionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "model": {
            "type": [
              "null",
              "string"
            ]
          },
          "fleet": {
            "type": "boolean"
          },
          "expiresInSeconds": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateCommandResult": {
        "required": [
          "commandId",
          "targetCount"
        ],
        "type": "object",
        "properties": {
          "commandId": {
            "type": "string",
            "format": "uuid"
          },
          "targetCount": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "CreateRolloutRequest": {
        "required": [
          "firmwareVersion",
          "regionId",
          "model",
          "maxDevices"
        ],
        "type": "object",
        "properties": {
          "firmwareVersion": {
            "type": "string"
          },
          "regionId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "model": {
            "type": [
              "null",
              "string"
            ]
          },
          "maxDevices": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "null",
              "integer",
              "string"
            ],
            "format": "int32"
          }
        }
      },
      "DemoAction": {
        "type": "integer"
      },
      "DemoControlSnapshot": {
        "required": [
          "revision",
          "admissionEnabled",
          "badReleaseVersion",
          "badReleaseModel",
          "dropGeneration",
          "resetGeneration",
          "resetAtUtc"
        ],
        "type": "object",
        "properties": {
          "revision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "admissionEnabled": {
            "type": "boolean"
          },
          "badReleaseVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "badReleaseModel": {
            "type": [
              "null",
              "string"
            ]
          },
          "dropGeneration": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "resetGeneration": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "resetAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          }
        }
      },
      "DemoRequest": {
        "required": [
          "requestId",
          "expectedRevision",
          "action",
          "admissionEnabled",
          "badReleaseVersion",
          "badReleaseModel"
        ],
        "type": "object",
        "properties": {
          "requestId": {
            "type": "string",
            "format": "uuid"
          },
          "expectedRevision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "action": {
            "$ref": "#/components/schemas/DemoAction"
          },
          "admissionEnabled": {
            "type": "boolean"
          },
          "badReleaseVersion": {
            "type": [
              "null",
              "string"
            ]
          },
          "badReleaseModel": {
            "type": [
              "null",
              "string"
            ]
          }
        }
      },
      "DemoStatus": {
        "required": [
          "desired",
          "appliedRevision",
          "sampledAtUtc",
          "dropAtUtc",
          "recoveryTarget",
          "connectedDevices",
          "resetPending",
          "gateways"
        ],
        "type": "object",
        "properties": {
          "desired": {
            "$ref": "#/components/schemas/DemoControlSnapshot"
          },
          "appliedRevision": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int64"
          },
          "sampledAtUtc": {
            "type": "string",
            "format": "date-time"
          },
          "dropAtUtc": {
            "type": [
              "null",
              "string"
            ],
            "format": "date-time"
          },
          "recoveryTarget": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "connectedDevices": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
          },
          "resetPending": {
            "type": "boolean"
          },
          "gateways": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/GatewayDemoStatus"
            }
          }
        }
      },
      "DeviceDetail": {
        "required": [
          "device",
          "cpuPercent",
          "memoryPercent",
          "temperatureCelsius"
        ],
        "type": "object",
        "properties": {
          "device": {
            "$ref": "#/components/schemas/DeviceListItem"
          },
          "cpuPercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "memoryPercent": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          },
          "temperatureCelsius": {
            "pattern": "^-?(?:0|[1-9]\\d*)(?:\\.\\d\u002B)?(?:[eE][\u002B-]?\\d\u002B)?$",
            "type": [
              "null",
              "number",
              "string"
            ],
            "format": "double"
          }
        }
      },
      "DeviceId": {
        "type": "string",
        "format": "uuid"
      },
      "DeviceListItem": {
        "required": [
          "id",
          "serialNumber",
          "model",
          "firmwareVersion",
          "siteId",
          "siteName",
          "regionId",
          "regionName",
          "online",
          "health",
          "lastSeenAt"
        ],
        "type": "object",
        "properties": {
          "id": {
            "$ref": "#/components/schemas/DeviceId"
          },
          "serialNumber": {
            "type": "string"
          },
          "model": {
            "type": "string"
          },
          "firmwareVersion": {
            "type": "string"
          },
          "siteId": {
            "pattern": "^-?(?:0|[1-9]\\d*)$",
            "type": [
              "integer",
              "string"
            ],
            "format": "int32"
